# Public hostname (no scheme), e.g. needrelay.example.com
DOMAIN=needrelay.example.com

# Let's Encrypt ACME contact
CADDY_EMAIL=admin@example.com

# Optional image tag (default: latest)
APP_IMAGE_TAG=latest

# Postgres
POSTGRES_DB=needrelay
POSTGRES_USER=needrelay
POSTGRES_PASSWORD=change-me-strong-db-password

# App
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
ADMIN_EMAIL=admin@needrelay.local
ADMIN_PASSWORD=ChangeMeAdmin123!
ADMIN_DISPLAY_NAME=NeedRelay Admin

# Must match https://$DOMAIN
APP_PUBLIC_BASE_URL=https://needrelay.example.com
CORS_ALLOWED_ORIGINS=https://needrelay.example.com

# Optional email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=NeedRelay <onboarding@resend.dev>
