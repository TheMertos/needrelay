# Copy to .env in this folder, then edit. See DEPLOY.md.

# Hostname only (no https://), e.g. needrelay.example.com
DOMAIN=needrelay.example.com

# Let's Encrypt contact (required)
CADDY_EMAIL=admin@example.com

# Image tag: latest, or pin e.g. v0.0.1
APP_IMAGE_TAG=latest

POSTGRES_DB=needrelay
POSTGRES_USER=needrelay
POSTGRES_PASSWORD=change-me-strong-db-password

# JWT_SECRET: at least 32 random characters (openssl rand -base64 48)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# First admin account (change password after first login)
ADMIN_EMAIL=admin@needrelay.local
ADMIN_PASSWORD=ChangeMeAdmin123!
ADMIN_DISPLAY_NAME=NeedRelay Admin

# Must be https:// plus the same host as DOMAIN
APP_PUBLIC_BASE_URL=https://needrelay.example.com
CORS_ALLOWED_ORIGINS=https://needrelay.example.com

# Optional. Empty = no invite/reset emails.
RESEND_API_KEY=
RESEND_FROM_EMAIL=NeedRelay <onboarding@resend.dev>
