# Copy to .env in this folder if you want to override defaults.
# Image tag: latest, or pin e.g. v0.0.1
APP_IMAGE_TAG=latest

JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Used only when the database is empty (before you run the optional seed).
ADMIN_EMAIL=admin@needrelay.local
ADMIN_PASSWORD=ChangeMeAdmin123!
ADMIN_DISPLAY_NAME=NeedRelay Admin

CORS_ALLOWED_ORIGINS=http://localhost:8081
APP_PUBLIC_BASE_URL=http://localhost:8081

# Optional. Empty = no invite/reset emails.
RESEND_API_KEY=
RESEND_FROM_EMAIL=NeedRelay <onboarding@resend.dev>
